        "-Dpixarlog=OFF",
        "-Dlzma=OFF",
        "-Dwebp=OFF",
        "-Djbig=OFF",
        "-Dzstd=OFF",
        "-Djpeg12=OFF",
        "-Dzlib=ON",
        "-Dlibdeflate=OFF",
        "-Dtiff-cxx=OFF",
        "-Dtiff-static=ON",
        "-Dtiff-tools=OFF",
        "-Dtiff-tests=OFF",
        "-Dtiff-contrib=OFF",
        "-Dtiff-docs=OFF",
        "-DCMAKE_CXX_STANDARD=17",
        "-DCMAKE_BUILD_TYPE=Release"
    ],
